<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="true" dependency-injector="ds" package-path="com.liferay.reading">
	<namespace>Reading</namespace>
	<entity local-service="true" name="Book" remote-service="false" trash-enabled="false" uuid="false">

		<!-- PK fields -->

		<column name="bookId" primary="true" type="long" />

		<!-- Group instance -->

		<column name="groupId" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="title" type="String" />
		<column name="author" type="String" />
		<column name="description" type="String" />

		<!-- Finder methods -->

		<finder name="GroupId" return-type="Collection">
			<finder-column name="groupId" />
		</finder>
		<finder name="CompanyId" return-type="Collection">
			<finder-column name="companyId" />
		</finder>
		<finder name="G_U" return-type="Collection">
			<finder-column name="groupId" />
			<finder-column name="userId" />
		</finder>
	</entity>
</service-builder>